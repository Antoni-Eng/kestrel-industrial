{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "ActiveChatProfile": "local",
    "ActiveEmbeddingProfile": "local",
    "RoleOverrides": {
      "rewrite": "local",
      "rerank": "local",
      "generate": "local"
    },
    "Profiles": {
      "local": {
        "Provider": "Ollama",
        "Endpoint": "http://localhost:11434",
        "ChatModel": "qwen2.5:7b",
        "EmbeddingModel": "nomic-embed-text",
        "ApiKey": "",
        "SupportsTools": true,
        "EmbeddingDimensions": 768
      },
      "desktop": {
        "Provider": "Ollama",
        "Endpoint": "http://YOUR.DESKTOP.IP:11434",
        "ChatModel": "qwen2.5:32b",
        "EmbeddingModel": "nomic-embed-text",
        "ApiKey": "",
        "SupportsTools": true,
        "EmbeddingDimensions": 768
      },
      "openai": {
        "Provider": "OpenAI",
        "Endpoint": "https://api.openai.com/v1",
        "ChatModel": "gpt-4o-mini",
        "EmbeddingModel": "text-embedding-3-small",
        "ApiKey": "",
        "SupportsTools": true,
        "EmbeddingDimensions": 1536
      }
    }
  },
  "Rag": {
    "DataRoot": "../data",
    "SqlitePath": "../data/kestrel.db",
    "TopK": 12,
    "RerankTopN": 5,
    "ChunkSizeTokens": 400,
    "ChunkOverlapTokens": 60,
    "MaxInputChars": 4000
  },
  "ConnectionStrings": {
    "qdrant": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    },
    "ApiKey": "",
    "CorsOrigins": [ "http://localhost:4200" ]
  }
}
